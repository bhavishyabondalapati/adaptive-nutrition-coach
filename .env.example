# Copy to .env and fill in. Both keys are optional: without them the app uses
# the offline rule-based parser and the bundled food CSV.

# Claude API key for natural-language food parsing (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Optional: force the parser: "claude" or "fake"
# LLM_PROVIDER=fake

# USDA FoodData Central key, free at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your-usda-api-key-here

# Optional: SQLite location (default: backend/coach.db). Use an absolute path.
# DATABASE_URL=sqlite:////absolute/path/to/coach.db
