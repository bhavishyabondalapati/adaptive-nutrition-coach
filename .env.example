# Copy to .env and fill in. All keys are optional: without them the app uses
# the offline rule-based parser and the bundled food CSV.

# Which LLM parses food text: gemini (default), claude, or fake (offline)
LLM_PROVIDER=gemini

# Google Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the model (default gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Claude key, only needed if LLM_PROVIDER=claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the model (default claude-haiku-4-5)
# CLAUDE_MODEL=claude-haiku-4-5

# USDA FoodData Central key, free at https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your-usda-api-key-here

# Optional: SQLite location (default: backend/coach.db). Use an absolute path.
# DATABASE_URL=sqlite:////absolute/path/to/coach.db
